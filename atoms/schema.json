{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-rules.local/schemas/atom.json",
  "title": "Atom",
  "type": "object",
  "required": ["id", "category", "priority", "text"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "category": { "enum": ["style", "format", "thinking", "research"] },
    "priority": { "enum": ["must", "should", "may"] },
    "text": { "type": "string", "minLength": 1, "maxLength": 280 },
    "rationale": { "type": "string" },
    "examples": {
      "type": "object",
      "properties": {
        "good": { "type": "array", "items": { "type": "string" } },
        "bad": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": { "enum": ["stable", "experimental", "deprecated"] },
    "review_after": { "type": "string" }
  },
  "additionalProperties": false
}
